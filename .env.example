# Model Evaluator Environment Variables
# Copy to .env and fill in actual values

# Required in production. Tests start their own ephemeral postgres:18 when no DSN is set.
MODEL_EVALUATOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5456/model_evaluator

# Optional (with defaults)
MODEL_EVALUATOR_SERVICE_NAME=model-evaluator
MODEL_EVALUATOR_PORT=8154
MODEL_EVALUATOR_ENVIRONMENT=production
MODEL_EVALUATOR_LOG_LEVEL=INFO
MODEL_EVALUATOR_LOG_FORMAT=json

# Upstream service URLs
MODEL_EVALUATOR_DATA_COLLECTOR_URL=http://localhost:8151
MODEL_EVALUATOR_MODEL_REGISTRY_URL=http://localhost:8155
MODEL_EVALUATOR_ADAPTER_MANAGER_URL=http://localhost:8001
MODEL_EVALUATOR_INFERENCE_ENDPOINT_URL=http://localhost:8080

# Evaluation config
MODEL_EVALUATOR_DEFAULT_THRESHOLD=0.85
MODEL_EVALUATOR_INFERENCE_TIMEOUT=30.0

# Observability
MODEL_EVALUATOR_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
